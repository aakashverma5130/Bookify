# ── Bookify Backend — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Full connection string (takes precedence over individual vars if set)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookify

# Or set individual vars (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookify
DB_USER=postgres
DB_PASSWORD=password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a long, random string — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── SMTP (Email — OTPs and daily reminders) ───────────────────────────────────
# For local dev, leave blank to use Ethereal (auto-creates a fake SMTP account)
# For production, fill in with your real SMTP provider (SendGrid, Gmail, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@bookify.edu

# ── Web Push (VAPID keys for browser push notifications) ─────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bookify.edu

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=5000

# ── File Storage ─────────────────────────────────────────────────────────────
# STORAGE_PROVIDER=local  → stores files in backend/uploads/ (default for dev)
# STORAGE_PROVIDER=s3     → stores files in S3-compatible bucket
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# S3-compatible storage (only used if STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Cron ──────────────────────────────────────────────────────────────────────
# Daily reminder job schedule (cron expression, default = 8:00 AM every day)
REMINDER_CRON=0 8 * * *
