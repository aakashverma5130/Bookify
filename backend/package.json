{
  "name": "booksphere-backend",
  "version": "1.0.0",
  "description": "Booksphere Library Management System — Node.js/Express REST API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/**/*.test.js",
    "generate-vapid": "web-push generate-vapid-keys",
    "db:schema": "psql $DATABASE_URL -f ../database/schema.sql",
    "db:seed": "psql $DATABASE_URL -f ../database/seed.sql"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
