# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Service-to-service auth (M-8) ────────────────────────────────────────────
# Shared secret used by the Node backend when calling this AI service.
# The backend sends it in the `X-Bookify-Auth` header on every request.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# MUST match the value in backend/.env (AI_SERVICE_AUTH_TOKEN).
AI_SERVICE_AUTH_TOKEN=replace-with-48-byte-hex-shared-secret

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookify

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
MODEL_CACHE_DIR=.cache/models

# ── Search Settings ───────────────────────────────────────────────────────────
SEARCH_CANDIDATE_LIMIT=50
SEMANTIC_WEIGHT=0.6

# ── Forecast Settings ─────────────────────────────────────────────────────────
FORECAST_WINDOW_DAYS=90
FORECAST_HIGH_THRESHOLD=10
FORECAST_MEDIUM_THRESHOLD=4

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5000
