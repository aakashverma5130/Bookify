# ── Bookify AI Service — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── PostgreSQL (read-only connection for the AI service) ──────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/bookify

# ── Embedding Model ───────────────────────────────────────────────────────────
# Model name from HuggingFace / sentence-transformers
# all-MiniLM-L6-v2 is fast and ~90MB — good default for this use case
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Directory where downloaded models are cached
# Leave blank to use the default HuggingFace cache (~/.cache/huggingface)
MODEL_CACHE_DIR=.cache/models

# ── Search Settings ───────────────────────────────────────────────────────────
# How many candidates to semantic-rank (pre-filter with keyword search first)
SEARCH_CANDIDATE_LIMIT=50
# Weight for semantic score vs keyword score (0.0 = keyword only, 1.0 = semantic only)
SEMANTIC_WEIGHT=0.6

# ── Forecast Settings ─────────────────────────────────────────────────────────
# How many days back to consider when computing issue frequency
FORECAST_WINDOW_DAYS=90
# Minimum issues in the window to be rated "High" demand
FORECAST_HIGH_THRESHOLD=10
FORECAST_MEDIUM_THRESHOLD=4

# ── CORS ──────────────────────────────────────────────────────────────────────
# Only the Node backend should call this service; restrict accordingly
ALLOWED_ORIGINS=http://localhost:5000
